# Cloudflare Pages cache headers for Gatsby
# Copy to public/_headers during build (Gatsby ignores public/ in git)

# Static assets — cache forever (content-hashed)
/static/*
  Cache-Control: public, max-age=31536000, immutable

/_gatsby/*
  Cache-Control: public, max-age=31536000, immutable

# Page data — short cache with stale-while-revalidate
/page-data/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/*.js
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/*.css
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

# Gatsby chunks — immutable (content-hashed)
/webpack-runtime-*.js
  Cache-Control: public, max-age=31536000, immutable

/Chunk-*.js
  Cache-Control: public, max-age=31536000, immutable

/slices/*.js
  Cache-Control: public, max-age=31536000, immutable
